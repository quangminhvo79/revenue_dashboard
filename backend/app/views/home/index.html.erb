<div class="flex w-full flex-col items-center gap-8 py-16 text-center">
  <p class="font-mono text-xs font-semibold tracking-widest text-admin-accent-strong uppercase">
    Revenue Dashboard
  </p>

  <h1 class="max-w-xl font-mono text-3xl font-semibold tracking-tight text-admin-ink">
    Revenue, managed in one place.
  </h1>

  <% if current_user.present? %>
    <div class="text-lg text-gray-800">
      Hi, <%= current_user.email %>
    </div>
  <% end %>

  <div class="flex flex-col gap-3 sm:flex-row">
    <% if current_user.present?  && policy(current_user).index? %>
      <%= link_to "Go to Admin", admin_root_path,
          class: "cursor-pointer border-0 bg-admin-accent px-6 py-3 font-mono text-xs font-semibold tracking-widest text-white uppercase transition-colors hover:bg-admin-accent-strong" %>
    <% end %>

    <% if current_user.present? %>
      <%= link_to "Log out", destroy_user_session_path, data: { turbo_method: :delete },
        class: "cursor-pointer border border-admin-rule bg-transparent px-6 py-3 font-mono text-xs font-semibold tracking-widest text-admin-ink uppercase transition-colors hover:border-admin-accent hover:text-admin-accent-strong" %>
    <% else %>
      <%= link_to "Log in", new_user_session_path,
        class: "cursor-pointer border border-admin-rule bg-transparent px-6 py-3 font-mono text-xs font-semibold tracking-widest text-admin-ink uppercase transition-colors hover:border-admin-accent hover:text-admin-accent-strong" %>
    <% end %>
  </div>
</div>
