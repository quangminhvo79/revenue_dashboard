<%= render "devise/shared/form_code", code: "Sign in", title: "Log in" %>

<%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
  <div class="mb-5">
    <%= f.label :email, class: "form-label" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-input" %>
  </div>

  <div class="mb-5">
    <%= f.label :password, class: "form-label" %>
    <%= f.password_field :password, autocomplete: "current-password", class: "form-input" %>
  </div>

  <% if devise_mapping.rememberable? %>
    <div class="mb-5 flex items-center gap-2">
      <%= f.check_box :remember_me, class: "h-4 w-4 accent-admin-accent" %>
      <%= f.label :remember_me, class: "text-sm text-admin-ink" %>
    </div>
  <% end %>

  <div class="mt-7">
    <%= f.submit "Log in", class: "form-submit" %>
  </div>
<% end %>

<%= render "devise/shared/links" %>
