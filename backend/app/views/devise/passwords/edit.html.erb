<%= render "devise/shared/form_code", code: "Form PW·02 — Set new password", title: "Change your password" %>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>
  <%= f.hidden_field :reset_password_token %>

  <div class="mb-5">
    <%= f.label :password, "New password", class: "form-label" %>
    <% if @minimum_password_length %>
      <p class="mb-1.5 text-sm text-admin-ink-muted"><%= @minimum_password_length %> characters minimum</p>
    <% end %>
    <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "form-input" %>
  </div>

  <div class="mb-5">
    <%= f.label :password_confirmation, "Confirm new password", class: "form-label" %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-input" %>
  </div>

  <div class="mt-7">
    <%= f.submit "Change my password", class: "form-submit" %>
  </div>
<% end %>

<%= render "devise/shared/links" %>
