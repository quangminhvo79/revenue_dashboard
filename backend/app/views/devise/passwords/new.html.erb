<%= render "devise/shared/form_code", code: "Reset request", title: "Forgot your password?" %>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="mb-5">
    <%= f.label :email, class: "form-label" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-input" %>
  </div>

  <div class="mt-7">
    <%= f.submit "Send me password reset instructions", class: "form-submit" %>
  </div>
<% end %>

<%= render "devise/shared/links" %>
